# En producción (atoo.io) el frontend llama a /api en el mismo origen;
# Vercel reescribe esas rutas al backend de CLIENTES.
# En staging / previews hay que apuntar al backend de PRUEBAS:
# VITE_API_URL=https://TU-BACKEND-STAGING.up.railway.app
# VITE_APP_ENV=staging

# Google OAuth (mismo Client ID que GOOGLE_CLIENT_ID en el backend)
# https://console.cloud.google.com/apis/credentials
# Añade https://staging.atoo.io a orígenes autorizados.
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# En producción (atoo.io) el frontend llama a /api en el mismo origen;
# Vercel reescribe esas rutas al backend. VITE_API_URL sigue haciendo falta
# en previews (*.vercel.app) y si pruebas el front fuera de atoo.io.
# VITE_API_URL=https://atoobackend-production.up.railway.app

# Google OAuth (mismo Client ID que GOOGLE_CLIENT_ID en el backend)
# https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
